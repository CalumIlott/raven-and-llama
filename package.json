{
  "name": "raven-and-llama",
  "version": "1.0.0",
  "private": true,
  "description": "Raven & Llama Learning Platform",
  "scripts": {
    "start": "node server.js",
    "prestart": "npm run build",
    "build:css": "tailwindcss --input ./tailwind.input.css --output ./public/css/tailwind.css --minify",
    "build:assets": "node scripts/copy-client-assets.js",
    "build": "npm run build:css && npm run build:assets",
    "pretest": "npm run build",
    "test": "npm run test:unit && npm run test:integration && npm run test:worker && npm run test:e2e",
    "test:css": "node scripts/verify-generated-assets.js",
    "test:unit": "node --test \"tests/unit/*.test.*\"",
    "test:integration": "node --test \"tests/integration/*.test.*\"",
    "pretest:worker": "npm run build",
    "test:e2e": "playwright test",
    "pretest:e2e": "npm run build",
    "test:worker": "wrangler deploy --dry-run",
    "audit": "npm audit --audit-level=high"
  },
  "engines": {
    "node": ">=22.5.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@tailwindcss/cli": "4.3.3",
    "canvas-confetti": "^1.9.4",
    "tailwindcss": "4.3.3",
    "wrangler": "^4.156.0"
  }
}
