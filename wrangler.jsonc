{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "raven-and-llama",
  "main": "worker.js",
  "compatibility_date": "2026-10-31",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/*"]
  },
  // Namespace IDs are account-unique; Preview uses a separate set of counters.
  "ratelimits": [
    {
      "name": "AUTH_LOGIN_IP_LIMITER",
      "namespace_id": "91372101",
      "simple": { "limit": 60, "period": 60 }
    },
    {
      "name": "AUTH_LOGIN_ACCOUNT_LIMITER",
      "namespace_id": "91372102",
      "simple": { "limit": 10, "period": 60 }
    },
    {
      "name": "AUTH_REGISTER_LIMITER",
      "namespace_id": "91372103",
      "simple": { "limit": 30, "period": 60 }
    }
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "raven-llama-accounts",
      "database_id": "0ea66bd8-01be-460c-8470-90c5dabfca49",
      "migrations_dir": "migrations"
    }
  ],
  "previews": {
    "ratelimits": [
      {
        "name": "AUTH_LOGIN_IP_LIMITER",
        "namespace_id": "91372201",
        "simple": { "limit": 60, "period": 60 }
      },
      {
        "name": "AUTH_LOGIN_ACCOUNT_LIMITER",
        "namespace_id": "91372202",
        "simple": { "limit": 10, "period": 60 }
      },
      {
        "name": "AUTH_REGISTER_LIMITER",
        "namespace_id": "91372203",
        "simple": { "limit": 30, "period": 60 }
      }
    ],
    "d1_databases": [
      {
        "binding": "DB",
        "database_name": "raven-llama-accounts-preview",
        "database_id": "8e976cf2-d12e-48d1-b26d-0dc3fec55832",
        "migrations_dir": "migrations"
      }
    ]
  }
}