{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "raven-and-llama",
  "main": "worker.js",
  "compatibility_date": "2026-10-31",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "raven-llama-accounts",
      "database_id": "0ea66bd8-01be-460c-8470-90c5dabfca49",
      "migrations_dir": "migrations"
    }
  ],
  "previews": {
    "d1_databases": [
      {
        "binding": "DB",
        "database_name": "raven-llama-accounts-preview",
        "database_id": "8e976cf2-d12e-48d1-b26d-0dc3fec55832",
        "migrations_dir": "migrations"
      }
    ]
  }
}